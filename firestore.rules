rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function carryDate(value) {
      let parts = value.split('-');
      let date = timestamp.date(int(parts[0]), int(parts[1]), int(parts[2]));
      // Device-local today may fall anywhere from UTC-12 to UTC+14.
      return date.year() == int(parts[0]) && date.month() == int(parts[1]) && date.day() == int(parts[2])
        && date >= (request.time - duration.value(12, 'h')).date()
        && date <= (request.time + duration.value(14, 'h')).date();
    }
    match /users/{userId}/todoCarryovers/{receiptId} {
      function owner() { return request.auth != null && request.auth.uid == userId; }
      function validReceipt(data) {
        return data.keys().hasAll(['sourceTodoId', 'targetTodoId', 'date', 'createdAt'])
          && data.keys().hasOnly(['sourceTodoId', 'targetTodoId', 'date', 'createdAt'])
          && data.sourceTodoId is string && data.sourceTodoId.matches('^[^/]+$')
          && data.targetTodoId is string && data.targetTodoId.matches('^[^/]+$')
          && data.sourceTodoId != data.targetTodoId
          && data.date is string && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && carryDate(data.date)
          && receiptId == data.sourceTodoId + '_' + data.date
          && data.createdAt == request.time;
      }
      function validPair(data) {
        let sourcePath = /databases/$(database)/documents/todos/$(data.sourceTodoId);
        let targetPath = /databases/$(database)/documents/todos/$(data.targetTodoId);
        let source = get(sourcePath).data;
        let target = getAfter(targetPath).data;
        return source.userId == userId && source.completed == false && source.date < data.date
          && getAfter(sourcePath).data == source
          && !exists(targetPath)
          && target.userId == userId && target.sourceTodoId == data.sourceTodoId
          && target.title == source.title.trim() && target.date == data.date
          && target.completed == false && target.createdAt == request.time;
      }
      allow read: if owner();
      allow create: if owner() && validReceipt(request.resource.data) && validPair(request.resource.data);
      // Keep receipts after deleting the copied todo to prevent another carry that day.
      allow update, delete: if false;
    }
    match /interviewQuestions/{questionId} {
      function owner() { return request.auth != null && resource.data.userId == request.auth.uid; }
      function tagValid(tags, i) {
        return tags.size() <= i || (tags[i] is string && tags[i].size() > 0 && tags[i].size() <= 30 && tags[i].trim() == tags[i]);
      }
      function valid(data) {
        return data.keys().hasAll(['userId', 'question', 'answer', 'tags', 'status', 'lastReviewedAt', 'createdAt'])
          && data.keys().hasOnly(['userId', 'question', 'answer', 'tags', 'status', 'lastReviewedAt', 'createdAt'])
          && data.userId is string && data.userId == request.auth.uid
          && data.question is string && data.question.size() >= 1 && data.question.size() <= 300
          && data.question.trim() == data.question
          && data.answer is string && data.answer.size() <= 10000
          && data.tags is list && data.tags.size() <= 10 && data.tags.toSet().size() == data.tags.size()
          && tagValid(data.tags, 0) && tagValid(data.tags, 1) && tagValid(data.tags, 2) && tagValid(data.tags, 3) && tagValid(data.tags, 4)
          && tagValid(data.tags, 5) && tagValid(data.tags, 6) && tagValid(data.tags, 7) && tagValid(data.tags, 8) && tagValid(data.tags, 9)
          && data.status == 'unknown' && data.lastReviewedAt == null
          && data.createdAt is timestamp && data.createdAt == request.time;
      }
      allow read: if owner();
      allow create: if request.auth != null && valid(request.resource.data);
      // Editing, deleting and review-state changes belong to subsequent issues.
      allow update, delete: if false;
    }
    match /studyLogs/{logId} {
      function calendarDate(value) {
        let parts = value.split('-');
        let year = int(parts[0]);
        let month = int(parts[1]);
        let day = int(parts[2]);
        let date = timestamp.date(year, month, day);
        // UTC+14 is the latest possible local date. The client applies its own
        // local-today limit; rules cannot infer the user's device time zone.
        return year >= 1 && date.year() == year && date.month() == month && date.day() == day
          && date <= (request.time + duration.value(14, 'h')).date();
      }
      function validStudyDate(value) {
        return value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && calendarDate(value);
      }
      function owner() { return request.auth != null && resource.data.userId == request.auth.uid; }
      function tagValid(tags, i) {
        return tags.size() <= i || (tags[i] is string && tags[i].size() > 0 && tags[i].size() <= 30 && tags[i].matches('.*[^\\s].*'));
      }
      function valid(data) {
        return data.keys().hasAll(['userId', 'title', 'content', 'tags', 'studyMinutes', 'createdAt'])
          && data.keys().hasOnly(['userId', 'title', 'content', 'tags', 'studyMinutes', 'createdAt', 'studyDate'])
          && (!('studyDate' in data) || validStudyDate(data.studyDate))
          && data.userId == request.auth.uid
          && data.title is string && data.title.size() > 0 && data.title.size() <= 100 && data.title.matches('.*[^\\s].*')
          && data.content is string && data.content.size() > 0 && data.content.size() <= 10000 && data.content.matches('[\\s\\S]*[^\\s][\\s\\S]*')
          && data.studyMinutes is int && data.studyMinutes >= 1 && data.studyMinutes <= 1440
          && data.createdAt is timestamp
          && data.tags is list && data.tags.size() <= 10 && data.tags.toSet().size() == data.tags.size()
          && tagValid(data.tags, 0) && tagValid(data.tags, 1) && tagValid(data.tags, 2) && tagValid(data.tags, 3) && tagValid(data.tags, 4)
          && tagValid(data.tags, 5) && tagValid(data.tags, 6) && tagValid(data.tags, 7) && tagValid(data.tags, 8) && tagValid(data.tags, 9);
      }
      allow read, delete: if owner();
      allow create: if request.auth != null && valid(request.resource.data)
        && request.resource.data.keys().hasAll(['studyDate']) && request.resource.data.createdAt == request.time;
      allow update: if owner() && valid(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'content', 'tags', 'studyMinutes', 'studyDate'])
        && (!('studyDate' in resource.data) || request.resource.data.keys().hasAll(['studyDate']));
    }
    match /todos/{todoId} {
      function signedIn() { return request.auth != null; }
      function owner() { return signedIn() && resource.data.userId == request.auth.uid; }
      function valid(data) {
        return data.keys().hasAll(['userId', 'title', 'completed', 'date', 'createdAt'])
          && data.keys().hasOnly(['userId', 'title', 'completed', 'date', 'createdAt', 'sourceTodoId'])
          && (!('sourceTodoId' in data) || (data.sourceTodoId is string && data.sourceTodoId.matches('^[^/]+$')))
          && data.userId is string && data.userId == request.auth.uid
          && data.title is string && data.title.size() >= 1 && data.title.size() <= 100
          && data.title.matches('.*[^\\s].*')
          && data.completed is bool
          && data.date is string && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && data.createdAt is timestamp;
      }
      function pairedReceipt(data) {
        let path = /databases/$(database)/documents/users/$(request.auth.uid)/todoCarryovers/$(data.sourceTodoId + '_' + data.date);
        let receipt = getAfter(path).data;
        return !exists(path) && receipt.sourceTodoId == data.sourceTodoId
          && receipt.targetTodoId == todoId && receipt.date == data.date
          && receipt.createdAt == request.time;
      }
      allow read, delete: if owner();
      allow create: if signedIn() && valid(request.resource.data)
        && request.resource.data.completed == false
        && request.resource.data.createdAt == request.time
        && (!('sourceTodoId' in request.resource.data) || pairedReceipt(request.resource.data));
      allow update: if owner() && valid(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'completed']);
    }
  }
}
